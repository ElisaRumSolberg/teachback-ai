# Set exactly one provider's key. LLM_PROVIDER is inferred from whichever is set,
# or set it explicitly if you have more than one key in your environment.
#
# FEATHERLESS_API_KEY is the recommended default for Pixel Forge AI Hackathon:
# sponsor-provided, free for 1 month via promo code PIXELFORGE26 at featherless.ai,
# OpenAI-compatible, 40,000+ open models (see FEATHERLESS_MODEL below).
FEATHERLESS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# LLM_PROVIDER=featherless
# FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3.2

PORT=3000
CONSISTENCY_RUNS=5
